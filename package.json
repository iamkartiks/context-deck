{
  "name": "contextdeck",
  "version": "0.1.0",
  "description": "One local index for every AI coding agent session (Claude Code, Codex, and more). Search, organise and resume your context windows across tools.",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "sessions",
    "context",
    "cli",
    "local-first",
    "sqlite"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "contextdeck": "bin/contextdeck.js"
  },
  "files": [
    "bin",
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --no-warnings --test \"dist/test/**/*.test.js\"",
    "demo": "npm run build && node bin/contextdeck.js --home .demo --claude-dir fixtures/claude --codex-dir fixtures/codex index && node bin/contextdeck.js --home .demo --claude-dir fixtures/claude --codex-dir fixtures/codex list",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.6.0"
  }
}
